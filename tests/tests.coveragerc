[run]

# TODO Files in 'pipeline-adapters' are excluded from coverage unless imported directly. See issue ML-9729.
source=
    ./mlrun
    ./server/py
    ./pipeline-adapters

relative_files = True

[report]
omit =
    test_*.py
    **/tests/*
    **/__init__.py
    **/conftest.py

skip_empty = False
